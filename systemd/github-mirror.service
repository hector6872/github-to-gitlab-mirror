[Unit]
Description=Daily GitHub to GitLab mirror
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=%u
WorkingDirectory=%h/gitlab-mirror-gist
ExecStart=%h/gitlab-mirror-gist/mirror.sh
EnvironmentFile=-%h/gitlab-mirror-gist/.env

# Low priority so it does not disturb system resources
Nice=10
IOSchedulingClass=idle

# Logs go to the journal (journalctl -u github-mirror.service)
StandardOutput=journal
StandardError=journal

TimeoutStartSec=2h

[Install]
WantedBy=multi-user.target
