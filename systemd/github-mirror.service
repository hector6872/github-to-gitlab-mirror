[Unit]
Description=Daily GitHub to GitLab mirror
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Adjust WorkingDirectory to your repository directory if running as system service,
# or place in ~/.config/systemd/user/ for non-root user timer.
WorkingDirectory=%h/gitlab-mirror-gist
ExecStart=%h/gitlab-mirror-gist/mirror.sh
EnvironmentFile=-%h/gitlab-mirror-gist/.env

# Low priority so it does not disturb system resources
Nice=10
IOSchedulingClass=idle

# Logs go to the journal (journalctl --user -u github-mirror.service)
StandardOutput=journal
StandardError=journal

TimeoutStartSec=2h

[Install]
WantedBy=default.target
