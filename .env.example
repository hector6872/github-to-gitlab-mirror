# =============================================================================
# GitHub -> GitLab Mirror Configuration
#
# Copy this file to .env and adjust your settings:
#   cp .env.example .env
#   chmod 600 .env
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub Configuration
# -----------------------------------------------------------------------------
# GitHub username (optional: auto-detected from GITHUB_TOKEN if omitted)
# GITHUB_USER="your-github-user"

# Personal Access Token with read access:
#   - Classic token : "repo" scope (+ "read:org" if mirroring org repos)
#   - Fine-grained  : Repository access = All repositories
#                     Permissions       = Contents: Read-only, Metadata: Read-only
GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# GitHub API endpoint (default: public GitHub)
GITHUB_API_URL="https://api.github.com"

# Space-separated list of extra organizations to mirror (empty = none)
GITHUB_ORGS=""

# Include forks in the mirror? (true | false)
GITHUB_INCLUDE_FORKS="false"

# Include archived repositories? (true | false, default: false)
GITHUB_INCLUDE_ARCHIVED="false"

# Repositories to exclude. Space-separated list of patterns.
# Supports full slugs ("owner/repo"), repository names ("repo"), or globs ("test-*").
# Example: GITHUB_EXCLUDE="test-* scratch-pad owner/private-note"
GITHUB_EXCLUDE=""

# -----------------------------------------------------------------------------
# GitLab Configuration
# -----------------------------------------------------------------------------
# GitLab username (optional: defaults to GITHUB_USER if omitted)
# GITLAB_USER="your-gitlab-user"

# Personal Access Token with "write_repository" scope (no API scope needed)
GITLAB_TOKEN="glpat_xxxxxxxxxxxxxxxxxxxx"

# GitLab instance URL (default: gitlab.com)
GITLAB_HOST="https://gitlab.com"

# Optional: target GitLab group or subgroup (e.g. "my-group" or "org/backups").
# If left empty, repositories are mirrored to your personal namespace.
GITLAB_GROUP=""

# SSH hostname for GitLab (only used when GIT_PROTOCOL="ssh")
GITLAB_SSH_HOST="gitlab.com"

# -----------------------------------------------------------------------------
# Mirror & Storage Behaviour
# -----------------------------------------------------------------------------
# Storage location for bare repository mirrors.
# Default is in-place under project directory (data/repos).
# You can also use an absolute path (e.g. "$HOME/.local/share/github-gitlab-mirror/repos")
MIRROR_DIR="./data/repos"

# Storage location for log files.
# Empty by default (no log files written to disk; streams directly to stdout / systemd journal).
# Specify a path (e.g. "./logs") if you want daily log files created on disk.
LOG_DIR=""

# Git transport protocol: "https" (token-based) or "ssh" (requires configured SSH keys)
GIT_PROTOCOL="https"

# Push to GitLab even if no changes were detected on GitHub.
# Keeps GitLab in sync even if remotes were modified manually.
PUSH_ALWAYS="true"

# Dry run mode: inspects remotes and plans actions without cloning or pushing (true | false)
DRY_RUN="false"

# -----------------------------------------------------------------------------
# Notifications (Optional)
# -----------------------------------------------------------------------------
# Send email notifications on completion or failure
EMAIL_NOTIFY="false"
EMAIL_TO=""
EMAIL_FROM=""

# Also send email on success (default only sends on failure)
EMAIL_ON_SUCCESS="false"

# Optional msmtp configuration path and account
MSMTP_CONFIG=""
MSMTP_ACCOUNT=""

# Optional incoming webhook URL (Slack, Discord, Mattermost)
WEBHOOK_URL=""
